####################################
# from device/google/seluna/bluetooth/bluetooth.prop
####################################
# Bluetooth
bluetooth.profile.bap.broadcast.assist.enabled=false
bluetooth.profile.bap.unicast.client.enabled=true
bluetooth.profile.csip.set_coordinator.enabled=true
bluetooth.profile.mcp.server.enabled=true
bluetooth.profile.ccp.server.enabled=true
bluetooth.profile.vcp.controller.enabled=true
bluetooth.a2dp.source.aptx_priority.config=-1
bluetooth.a2dp.source.aptx_hd_priority.config=-1
bluetooth.a2dp.source.ldac_priority.config=-1
bluetooth.core.classic.sniff_max_intervals=816,400,54,150,18,36,18,800
bluetooth.core.classic.sniff_min_intervals=400,200,30,50,10,30,14,400
bluetooth.core.classic.sniff_attempts=4,4,4,4,4,2,1,0
bluetooth.core.classic.sniff_timeouts=1,1,1,1,1,0,0,0
bluetooth.bta_fts_ops_idle_to_sniff_delay_ms.config=2000
bluetooth.bta_ftc_idle_to_sniff_delay_ms.config=1000
bluetooth.hfp.version.config=0x109
bluetooth.hfp.swb.supported=true
# Bluetooth Page scan Interval time = N * 0.625 ms
# Range: 0x0012 to 0x1000, Default value: 0x400
bluetooth.core.classic.page_scan_interval=2048
# The bluetooth stack needs 10s to start when running in passthrough mode
bluetooth.gd.start_timeout=10000
# The Hci command timeout value for BT stack
bluetooth.hci.timeout_milliseconds=5000
# After hitting HCI command timeout issue, waiting time for the BT stack to assert
# after sending the controller debug info command
bluetooth.hci.restart_timeout_milliseconds=5000
persist.vendor.bluetooth.enable_lpm=true
persist.bluetooth.leaudio_offload.disabled=false
persist.display_le_audio_toggle=false
ro.bluetooth.leaudio_offload.supported=true
persist.vendor.bluetooth.enable_duration_tracker=true
# Bluetooth device id
# Seluna: 0x3103
bluetooth.device_id.product_id=12547
# b/381773720 - Increase the BTHAL wakelock timeout to keep whole system awake until WearServices is finished processing notifications
persist.vendor.bluetooth.wakelock_timeout=500
